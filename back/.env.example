# Modèle de configuration du serveur (back/.env en production).
# Copier ce fichier en "back/.env" sur le serveur et remplir les valeurs.
# Ne jamais mettre de vrai mot de passe dans CE fichier (il est versionné).

# --- Serveur ---
PORT=5000
NODE_ENV=production

# --- Adresses du site ---
# Adresse publique du site (utilisée pour les retours de paiement Stripe)
FRONTEND_URL=https://www.institut-cote-detente.fr
# Adresse publique de l'API (même domaine : nginx redirige /api et /uploads vers Node)
PUBLIC_SITE_URL=https://www.institut-cote-detente.fr

# --- Base de données (MongoDB Atlas) ---
MONGO_URI=mongodb+srv://UTILISATEUR:MOT_DE_PASSE@cluster0.xxxxx.mongodb.net/NOM_BASE

# --- Connexion admin ---
# Longue chaîne aléatoire, différente de celle du développement
# (génération : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=

# --- E-mails (formulaires contact, RDV ménopause, cartes cadeaux) ---
EMAIL_USER=adresse@orange.fr
EMAIL_PASSWORD=
CONTACT_RECEIVER_EMAIL=adresse@orange.fr

# --- Stripe (cartes cadeaux) : clés du mode RÉEL ---
STRIPE_SECRET_KEY=sk_live_...
# Secret du webhook créé dans Stripe pour https://www.institut-cote-detente.fr/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Instagram (publication des évènements) ---
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=
